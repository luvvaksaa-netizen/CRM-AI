# =============================================================================
# V2-Core Production Environment (laptop server Lenovo)
# Simpan ini sebagai .env di v2-core/backend/
# =============================================================================

# ─── AI API Keys ───────────────────────────────────────────────────────────
DEEPSEEK_API_KEY=sk-(rahasia)
OPENAI_API_KEY=sk-proj-(rahasia)
MODEL_NAME=deepseek-chat

# ─── Server ────────────────────────────────────────────────────────────────
PORT=3002
NODE_ENV=production

# ─── Database ──────────────────────────────────────────────────────────────
DATA_DIR=D:\CRM-AI\data

# ─── Auth ──────────────────────────────────────────────────────────────────
ADMIN_USER=admin
ADMIN_PASS=admin123
SESSION_SECRET=xc5upH16ZEe8LqWihNYIGVvQk7dP3mUwJ9tRCXafSnO20FojBrlgyzTMDbAK4s
JWT_SECRET=xc5upH16ZEe8LqWihNYIGVvQk7dP3mUwJ9tRCXafSnO20FojBrlgyzTMDbAK4s

# ─── CORS ──────────────────────────────────────────────────────────────────
# Domain production + local dev
CORS_ORIGINS=http://localhost:5173,http://localhost:3002,https://crm.datasdm.com

# ─── WhatsApp Engine ──────────────────────────────────────────────────────
# Jumlah RAM yang dialokasikan PER browser Chromium (MB)
# 384MB × 10 WA session = 3.8GB total (aman di RAM 16GB)
WA_CHROMIUM_HEAP_MB=384

# Maksimum pesan yang boleh dikirim per store per MENIT
# 120 = 2 pesan/detik — cukup untuk real-time chat tanpa delay
WA_MAX_SENDS_PER_MINUTE=120

# Jeda minimum antar kirim pesan ke kontak yang SAMA (ms)
# 1000ms = 1 detik — cegah spam tapi tidak bikin delay
WA_SEND_COOLDOWN_MS=1000

# Timeout tunggu WhatsApp client siap sebelum kirim pesan (ms)
WA_SEND_READY_TIMEOUT_MS=30000

# Interval pengecekan kesehatan WhatsApp session (ms)
# 180000ms = 3 menit — cukup untuk deteksi masalah tanpa membebani CPU
WA_HEALTH_CHECK_INTERVAL_MS=180000

# Timeout saat cek status WhatsApp (getState)
WA_HEALTH_HANG_TIMEOUT_MS=10000

# Timeout saat cek daftar chat (getChats)
WA_CHAT_PROBE_TIMEOUT_MS=15000

# Jumlah chat terbaru yang disinkron saat WhatsApp connect
WA_RECENT_SYNC_CHATS=30

# Jumlah pesan per chat yang disinkron saat awal connect
WA_RECENT_SYNC_MESSAGES=30

# ─── PM2 Memory ────────────────────────────────────────────────────────────
# Auto-restart Node.js kalau memori > 4GB (cegah memory leak parah)
PM2_MAX_MEMORY=4000

# ─── Scalev Order Management ───────────────────────────────────────────────
SCALEV_API_KEY=sk_UzMyqqZV0mrOLMiiiJF4hj9Mqy3g3JMLLUPK2rzTl4INbBSmvW9TCBRH4djl864F
SCALEV_STORE_UNIQUE_ID=store_jkCuKaF7LNtzTgK8YiTa1XNG
