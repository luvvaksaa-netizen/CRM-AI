# ============================================================
# WA-AI-CS Environment Variables
# Copy this file to .env and fill in the values.
# JANGAN commit file .env ke git!
# ============================================================

# Server
PORT=3001
NODE_ENV=development

# Session & Security
# Di production: WAJIB diganti dengan string random panjang (min 32 karakter).
# Server TIDAK AKAN START jika NODE_ENV=production dan SESSION_SECRET kosong/default.
SESSION_SECRET=change-me

# Dashboard Admin Credentials
ADMIN_USER=admin
ADMIN_PASS=change-me

# Multi-admin (opsional, format JSON array):
# ADMIN_USERS_JSON=[{"user":"admin","pass":"xxx","role":"admin"},{"user":"cs1","pass":"yyy","role":"operator"}]

# Socket.IO CORS Origins (comma-separated)
# Di production: ganti dengan domain dashboard Anda.
DASHBOARD_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001

# AI Provider — Minimal salah satu harus diisi
OPENAI_API_KEY=
GROQ_API_KEYS=

# AI Model
MODEL_NAME=gpt-4o-mini
GROQ_MODEL_TEXT=llama-3.3-70b-versatile

# AI Behavior Tuning
AI_REPLY_DEBOUNCE_MS=1200
AI_ACTIVE_REPLY_WAIT_MS=600

# WhatsApp Client
WA_SEND_READY_TIMEOUT_MS=45000

# Shipping API (Opsional)
# RAJAONGKIR_API_KEY=
# ORIGIN_NAME=Kediri

# Data Directory (opsional, default: ./data/)
# DATA_DIR=/var/data/crm
